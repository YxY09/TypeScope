{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeScope",
  "version": "0.1.0",
  "identifier": "cc.typescope.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeScope 打字统计",
        "width": 1180,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
